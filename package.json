{
  "name": "dsh-wps-plugin",
  "version": "0.1.0",
  "description": "DeepSeek Harness 插件 - 金山文档 WPS 能力集成",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "keytar": "^7.9.0",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "wps",
    "kingsoft",
    "kdocs",
    "cordis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/<your-org>/dsh-wps-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/<your-org>/dsh-wps-plugin/issues"
  },
  "homepage": "https://github.com/<your-org>/dsh-wps-plugin#readme"
}
